import java.util.Scanner;

public class ListaDiariaFinal {
    // # Função de validação de CPF adaptada de [IA,ChatGPT,Copilot]
    // consultei IA só pra lembrar como fazia um menu simples
    static void mostrarMenu(){
        System.out.println("1 - nova tarefa");
        System.out.println("2 - finalizar");
        System.out.println("3 - ver todas");
        System.out.println("4 - ver pontos");
        System.out.println("0 - sair");
        System.out.print("opc: ");
    }

    public static void main(String[] args) {

        Scanner ler = new Scanner(System.in);

        String lista[] = new String[7];
        boolean feito[] = new boolean[7];

        int qtd = 0;
        int op = -1;

        while(op != 0){

            System.out.println("\n--- MENU ---");

            mostrarMenu();
            op = ler.nextInt();
            ler.nextLine(); // buffer

            if(op == 1){
                if(qtd < lista.length){
                    System.out.print("digite a tarefa: ");
                    String temp = ler.nextLine();
                    lista[qtd] = temp;
                    feito[qtd] = false;
                    qtd++;
                } else {
                    System.out.println("lista cheia, não cabe mais");
                }
            }

            else if(op == 2){
                System.out.print("qual posição? ");
                int id = ler.nextInt();
                ler.nextLine();

                if(id > 0 && id <= qtd){
                    feito[id - 1] = true;
                } else {
                    System.out.println("posicao invalida");
                }
            }

            else if(op == 3){
                System.out.println("---- tarefas ----");
                int i = 0;
                while(i < qtd){
                    if(feito[i] == true){
                        System.out.println((i+1) + ": " + lista[i] + " (ok)");
                    } else {
                        System.out.println((i+1) + ": " + lista[i] + " (pend)");
                    }
                    i++;
                }
            }

            else if(op == 4){
                int pontos = 0;
                for(int k=0; k<qtd; k++){
                    if(feito[k]){
                        pontos++;
                    }
                }
                System.out.println("pontos ganhos: " + pontos);
            }

            else if(op != 0){
                System.out.println("nao conheco essa opcao");
            }
        }

        System.out.println("encerrando programa...");
        ler.close();
    }
}
